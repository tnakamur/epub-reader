# ─────────────────────────────────────────────
# .env.example
# cp .env.example .env して実際の値を設定すること
# .env は .gitignore に追加済み
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=epub_reader
POSTGRES_USER=epub_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────
# openssl rand -hex 64 で生成推奨
JWT_SECRET=CHANGE_ME_JWT_SECRET_64CHARS
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_64CHARS
JWT_REFRESH_EXPIRES_IN=30d

# ── ファイルアップロード ───────────────────────
MAX_FILE_SIZE_MB=50

# ── ドメイン（Caddy設定と合わせる）──────────────
DOMAIN=epub.t-nakamura.mydns.jp
